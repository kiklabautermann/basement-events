rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Events: Lesen ist oeffentlich, Schreiben nur fuer authentifizierte Admins.
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Einstellungen (Social Links): Lesen ist oeffentlich, Schreiben nur fuer authentifizierte Admins.
    match /settings/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Standard: Alles andere ist verboten (least privilege).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
