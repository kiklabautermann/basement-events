rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Nur der fest definierte Admin-Account darf schreiben.
    // WICHTIG: Eine reine Pruefung auf request.auth != null genuegt NICHT,
    // da sich jeder ueber die Firebase-API selbst registrieren kann.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'basement.events@proton.me';
    }

    // Events: Lesen ist oeffentlich, Schreiben nur fuer den Admin.
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Einstellungen (Social Links): Lesen ist oeffentlich, Schreiben nur fuer den Admin.
    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Standard: Alles andere ist verboten (least privilege).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
